default_platform(:ios)

def connect_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    in_house: false
  )
end

platform :ios do
  desc "Build and upload the current build to TestFlight"
  lane :beta do
    api_key = connect_api_key
    build_number = ENV.fetch("BUILD_NUMBER", Time.now.strftime("%Y%m%d%H%M"))
    increment_build_number(xcodeproj: "MiyTylApp/MiyTyl.xcodeproj", build_number: build_number)
    build_app(
      project: "MiyTylApp/MiyTyl.xcodeproj",
      scheme: "MiyTyl",
      clean: true,
      export_method: "app-store",
      xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch('TEAM_ID')}"
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true, distribute_external: false)
  end

  desc "Validate and upload a release build to App Store Connect"
  lane :release do
    api_key = connect_api_key
    build_app(
      project: "MiyTylApp/MiyTyl.xcodeproj",
      scheme: "MiyTyl",
      clean: true,
      export_method: "app-store",
      xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch('TEAM_ID')}"
    )
    upload_to_app_store(api_key: api_key, submit_for_review: false, automatic_release: false, skip_screenshots: true)
  end
end
